# Flink image with Python + PyFlink so the streaming job can run distributed.
# Build (from the project root):  docker compose -f deploy/docker-compose.yml build
FROM flink:1.20-scala_2.12-java17

USER root

RUN apt-get update \
    && apt-get install -y --no-install-recommends python3 python3-venv python3-dev \
    && rm -rf /var/lib/apt/lists/*

RUN python3 -m venv /opt/venv \
    && /opt/venv/bin/pip install --no-cache-dir --upgrade pip setuptools wheel \
    && /opt/venv/bin/pip install --no-cache-dir apache-flink==1.20.5

# Project code (import path for the job) and the Kafka connector on Flink's classpath.
# Build context is the project root (see deploy/docker-compose.yml -> context: ..).
COPY sketchstream /opt/sketchstream/sketchstream
COPY flink /opt/flink
COPY jars/ /opt/flink/lib/

ENV PATH=/opt/venv/bin:$PATH
ENV PYTHONPATH=/opt/sketchstream:/opt/flink
ENV PYFLINK_PYTHON=/opt/venv/bin/python

WORKDIR /opt
